<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.pi-agent.server</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/.local/share/pi-node/current/bin/node</string>
    <string>__HOME__/.pi-agent/daemon.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.pi-agent/pia</string>
  <key>EnvironmentVariables</key><dict>
    <key>NODE_NO_WARNINGS</key><string>1</string>
    <key>LANG</key><string>ru_RU.UTF-8</string>
    <key>PATH</key><string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/.pi-agent/daemon.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.pi-agent/daemon.out</string>
</dict></plist>
