{
  "mcpServers": {
    "notion": {
      "command": "__HOME__/.local/bin/npx",
      "args": ["-y", "mcp-remote", "https://mcp.notion.com/mcp"]
    },
    "framer": {
      "command": "__HOME__/.local/bin/npx",
      "args": ["-y", "mcp-remote", "https://mcp.framer.com/mcp"]
    },
    "figwright": {
      "command": "__HOME__/.local/bin/npx",
      "args": ["-y", "@figwright/mcp@latest"]
    }
  }
}
